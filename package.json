{
  "name": "deye-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA realtime solar monitor for Deye Cloud — Vite + React + Cloudflare Workers + D1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "db:create": "wrangler d1 create deye-monitor",
    "db:init": "wrangler d1 execute deye-monitor --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "vitest run"
  },
  "dependencies": {
    "@meteocons/svg": "^0.1.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
