# Copy to ".dev.vars" for local `wrangler dev`. NEVER commit the real file.
# In production set these with: wrangler secret put <NAME>  (or the Cloudflare dashboard / Deploy button)

# Deye Cloud account (developer.deyecloud.com) — all four required
DEYE_APP_ID=your_app_id_here
DEYE_EMAIL=your_deyecloud_login_email
DEYE_APP_SECRET=your_app_secret_here
DEYE_PASSWORD=your_deyecloud_login_password
# App PIN gate — optional (no PIN = public)
APP_PIN=1234
# TMD (กรมอุตุฯ) token — optional; falls back to Open-Meteo if blank
TMD_TOKEN=
# Grid nominals for the inverter health checks — optional. Describe YOUR site
# (Thailand single-phase: 230 / 50). Unset = absolute voltage/frequency alarms
# stay silent; relative phase-balance checks still run. Never inferred from data.
GRID_NOMINAL_V=
GRID_NOMINAL_HZ=
# Outbound alerts — optional; unset = no alerts. Discord-compatible webhook and/or
# Telegram bot. Rules: inverter offline, Deye unreachable 3 ticks, ≈0 W in the
# site's peak-sun window 3 ticks, grid voltage lost under load, battery below
# ALERT_SOC_MIN, and warn-level health findings. Test: POST /api/_alert_test
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SOC_MIN=
ALERT_REPEAT_MIN=
